     * LOOP PRINCIPAL  –  do-while
     * ─────────────────────────────
     * do-while executa o bloco PELO MENOS UMA VEZ antes de testar
     * a condição.  Aqui: exibe o menu → lê a opção → executa →
     * repete enquanto opcao != 0.
     * Quando o usuário digitar 0, a condição falha e o programa encerra.
     */
    do {
        /* Menu visual com bordas feitas de caracteres ASCII */
        printf("\n+==============================+\n");
        printf(  "|    GRAFO DE BAIRROS - CWB    |\n");
        printf(  "+==============================+\n");
        printf(  "|  1. Testar conexao direta    |\n");
        printf(  "|  2. Mostrar grafo completo   |\n");
        printf(  "|  3. Conexoes de um bairro    |\n");
        printf(  "|  4. Adicionar conexao        |\n");
        printf(  "|  5. Remover conexao          |\n");
        printf(  "|  6. Testar simetria          |\n");
        printf(  "|  0. Sair                     |\n");
        printf(  "+==============================+\n");
        printf("  Opcao: ");
        scanf("%d", &opcao);   // lê o inteiro digitado
        getchar();             // consome o '\n' deixado pelo scanf para não
                               // atrapalhar leituras de strings feitas depois

        printf("\n");

        /*
         * switch-case: desvia para a função correspondente
         * à opção escolhida.  "default" trata entradas inesperadas.
         */
        switch (opcao) {
            case 1: testarConexaoDireta(matriz, nomes);   break;
            case 2: mostrarGrafo(matriz, nomes);          break;
            case 3: todasConexoesDeBairro(matriz, nomes); break;
            case 4: adicionarConexao(matriz, nomes);      break;
            case 5: removerConexao(matriz, nomes);        break;
            case 6: verificarSimetria(matriz, nomes);     break;
            case 0: printf("  Encerrando o programa. Ate logo!\n\n"); break;
            default: printf("  [!] Opcao invalida. Tente novamente.\n"); break;
        }

    } while (opcao != 0);

    return 0; // retorna 0 ao sistema operacional indicando sucesso
}


// ═══════════════════════════════════════════════════════════════
//  FUNÇÃO AUXILIAR: buscarBairro
//  ─────────────────────────────
//  Lê um nome do teclado e devolve o índice correspondente
//  no array nomes[].  Retorna -1 se não encontrar.
//
//  Por que é "auxiliar"?  Porque outras funções a chamam para
//  não precisar repetir o mesmo código de leitura + busca.
// ═══════════════════════════════════════════════════════════════
int buscarBairro(const char *nomes[TAM]) {
    char nome[TAM]; // buffer temporário para guardar o que o usuário digitou

    printf("  Nome do bairro: ");
    /*
     * scanf(" %74[^\n]", nome)
     *  " "       → ignora espaços/quebras de linha pendentes no buffer
     *  %74[^\n]  → lê até 74 caracteres que NÃO sejam '\n'
     *              (ou seja, lê uma linha inteira com espaços)
     *  O limite 74 previne estouro do buffer de tamanho 75
     *  (74 chars + 1 para o '\0' terminador)
     */
    scanf(" %74[^\n]", nome);

    /* Percorre todos os bairros comparando strings com strcmp.
     * strcmp retorna 0 quando as strings são iguais. */
    for (int i = 0; i < TAM; i++) {
        if (strcmp(nome, nomes[i]) == 0)
            return i; // achou: devolve o índice
    }

    printf("\n  [!] Bairro \"%s\" nao encontrado.\n", nome);
    return -1; // não achou: devolve sentinela -1
}


