    printf("  Indice X (0-%d): ", TAM - 1);
    scanf("%d", &x);
    printf("  Indice Y (0-%d): ", TAM - 1);
    scanf("%d", &y);

    /* Validação de intervalo: índices devem estar entre 0 e TAM-1 */
    if (x < 0 || x >= TAM || y < 0 || y >= TAM) {
        printf("\n  [!] Posicao invalida.\n");
        return;
    }

    printf("\n  Resultado: ");
    if (matriz[x][y] == 1)
        printf("%s  <-->  %s  [CONECTADOS]\n", nomes[x], nomes[y]);
    else
        printf("%s  <-X->  %s  [SEM CONEXAO DIRETA]\n", nomes[x], nomes[y]);
}


// ═══════════════════════════════════════════════════════════════
//  FUNÇÃO 2: mostrarGrafo
//  ───────────────────────
//  Percorre toda a matriz e imprime, para cada bairro,
//  a lista de seus vizinhos diretos (onde há valor 1 na linha).
//
//  A flag "primeiro" controla a vírgula entre os nomes:
//  não coloca vírgula antes do primeiro vizinho.
// ═══════════════════════════════════════════════════════════════
void mostrarGrafo(int matriz[TAM][TAM], const char *nomes[TAM]) {
    printf("  --- Grafo Completo ---\n\n");

    for (int i = 0; i < TAM; i++) {
        /* Imprime o cabeçalho da linha: índice + nome do bairro */
        printf("  [%2d] %-22s ->", i, nomes[i]);
        /*
         * %2d    → inteiro com largura mínima 2 (alinha os índices)
         * %-22s  → string alinhada à esquerda com 22 caracteres de largura
         *          (deixa o "->" sempre na mesma coluna visual)
         */

        int primeiro = 1; // flag: 1 = ainda não imprimiu nenhum vizinho

        for (int j = 0; j < TAM; j++) {
            if (matriz[i][j] == 1) {
                if (!primeiro) printf(","); // coloca vírgula a partir do 2º
                printf(" %s", nomes[j]);
                primeiro = 0; // já imprimiu pelo menos um
            }
        }

        if (primeiro) printf(" (sem conexoes)"); // nenhum 1 encontrado na linha
        printf("\n");
    }
}


// ═══════════════════════════════════════════════════════════════
//  FUNÇÃO 3: todasConexoesDeBairro
//  ────────────────────────────────
//  Usa buscarBairro() para localizar o bairro pelo nome e
//  lista todos os vizinhos diretos dele percorrendo
//  a linha correspondente na matriz.
// ═══════════════════════════════════════════════════════════════
void todasConexoesDeBairro(int matriz[TAM][TAM], const char *nomes[TAM]) {
    printf("  --- Conexoes de um Bairro ---\n");

    int bairro = buscarBairro(nomes); // retorna o índice ou -1
    if (bairro == -1) return;         // nome não encontrado: sai da função

    printf("\n  Bairros conectados a \"%s\":\n", nomes[bairro]);

    int encontrou = 0;
    for (int j = 0; j < TAM; j++) {
        if (matriz[bairro][j]) {   // equivale a: if (matriz[bairro][j] == 1)
            printf("    - %s\n", nomes[j]);
            encontrou = 1;
        }
    }

    if (!encontrou)
        printf("    (nenhuma conexao encontrada)\n");
}


// ═══════════════════════════════════════════════════════════════
//  FUNÇÃO 4: adicionarConexao
//  ───────────────────────────
//  Lê dois nomes de bairros, localiza seus índices e seta
//  matriz[id1][id2] = 1  E  matriz[id2][id1] = 1
//  (ambos os sentidos, mantendo a simetria do grafo não-dirigido).
//
//  Antes de adicionar, verifica se a conexão já existe.
// ═══════════════════════════════════════════════════════════════
void adicionarConexao(int matriz[][TAM], const char *nomes[TAM]) {
    char bairro1[TAM], bairro2[TAM]; // buffers para os nomes lidos
    int id1 = -1, id2 = -1;          // índices inicializados como "não encontrado"

    printf("  --- Adicionar Conexao ---\n");
    printf("  Bairro 1: ");
    scanf(" %74[^\n]", bairro1);
    printf("  Bairro 2: ");
    scanf(" %74[^\n]", bairro2);

    /* Busca linear nos dois arrays ao mesmo tempo */
    for (int i = 0; i < TAM; i++) {
        if (strcmp(bairro1, nomes[i]) == 0) id1 = i;
        if (strcmp(bairro2, nomes[i]) == 0) id2 = i;
    }

    /* Validação: qualquer índice -1 significa nome não encontrado */
    if (id1 == -1) { printf("\n  [!] Bairro \"%s\" nao encontrado.\n", bairro1); return; }
    if (id2 == -1) { printf("\n  [!] Bairro \"%s\" nao encontrado.\n", bairro2); return; }

    /* Verifica se a aresta já existe antes de sobrescrever */
    if (matriz[id1][id2] == 1) {
        printf("\n  [!] \"%s\" e \"%s\" ja estao conectados.\n", bairro1, bairro2);
        return;
    }

    /* Insere nos dois sentidos para manter a simetria */
    matriz[id1][id2] = 1;
    matriz[id2][id1] = 1;
    printf("\n  [OK] Conexao adicionada: %s  <-->  %s\n", nomes[id1], nomes[id2]);
}


// ═══════════════════════════════════════════════════════════════
//  FUNÇÃO 5: removerConexao
//  ─────────────────────────
//  Lógica espelhada de adicionarConexao, mas seta 0 em vez de 1.
//  Antes de remover, verifica se a conexão realmente existe.
// ═══════════════════════════════════════════════════════════════
void removerConexao(int matriz[][TAM], const char *nomes[TAM]) {
    char bairro1[TAM], bairro2[TAM];
    int id1 = -1, id2 = -1;

    printf("  --- Remover Conexao ---\n");
    printf("  Bairro 1: ");
    scanf(" %74[^\n]", bairro1);
    printf("  Bairro 2: ");
    scanf(" %74[^\n]", bairro2);

    for (int i = 0; i < TAM; i++) {
        if (strcmp(bairro1, nomes[i]) == 0) id1 = i;
        if (strcmp(bairro2, nomes[i]) == 0) id2 = i;
    }

    if (id1 == -1) { printf("\n  [!] Bairro \"%s\" nao encontrado.\n", bairro1); return; }
    if (id2 == -1) { printf("\n  [!] Bairro \"%s\" nao encontrado.\n", bairro2); return; }

    /* Verifica se existe conexão a ser removida */
    if (matriz[id1][id2] == 0) {
        printf("\n  [!] Nao existe conexao entre \"%s\" e \"%s\".\n", bairro1, bairro2);
        return;
    }

    /* Remove nos dois sentidos */
    matriz[id1][id2] = 0;
    matriz[id2][id1] = 0;
    printf("\n  [OK] Conexao removida: %s  <-X->  %s\n", nomes[id1], nomes[id2]);
}


// ═══════════════════════════════════════════════════════════════
//  FUNÇÃO 6: verificarSimetria
//  ────────────────────────────
//  Uma matriz de adjacência para um grafo NÃO-DIRIGIDO deve ser
//  simétrica: matriz[i][j] == matriz[j][i] para todo i, j.
//
//  O truque do loop "j = i + 1" evita verificar o mesmo par
//  duas vezes e ignora a diagonal principal (i == j).
//  Se algum par assimétrico for encontrado, ele é impresso.
// ═══════════════════════════════════════════════════════════════
void verificarSimetria(int matriz[TAM][TAM], const char *nomes[TAM]) {
    printf("  --- Verificar Simetria ---\n\n");

    int encontrou = 0; // flag: ficará 1 se achar pelo menos uma assimetria

    for (int i = 0; i < TAM; i++) {
        /*
         * j começa em i+1 para analisar apenas o triângulo superior
         * da matriz (pares únicos sem repetição e sem diagonal).
         */
        for (int j = i + 1; j < TAM; j++) {
            if (matriz[i][j] != matriz[j][i]) {
                /* Mostra os dois valores conflitantes para diagnóstico */
                printf("  [%s(%d)][%s(%d)] = %d\n", nomes[i], i, nomes[j], j, matriz[i][j]);
                printf("  [%s(%d)][%s(%d)] = %d\n", nomes[j], j, nomes[i], i, matriz[j][i]);
                printf("\n");
                encontrou = 1;
            }
        }
    }

    if (!encontrou)
        printf("  [OK] A matriz e simetrica.\n");
}
